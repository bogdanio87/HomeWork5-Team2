# Polymarket API credentials
POLY_API_KEY=your_api_key_here
POLY_API_SECRET=your_api_secret_here
POLY_PASSPHRASE=your_passphrase_here

# Wallet
PRIVATE_KEY=your_wallet_private_key_here

# Proxy (for geo-restricted access via IPRoyal, etc.)
# Set USE_PROXY=false to disable proxy and connect directly
USE_PROXY=true
PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PASS=

# Trading config
INITIAL_BALANCE=1000
MAX_POSITION_SIZE=200
STOP_LOSS_PCT=0.10
TAKE_PROFIT_PCT=0.30
MAX_DAILY_LOSS=150

# Strategy
STRATEGY=combined
# Options: arbitrage, momentum, market_making, combined

# Risk level: conservative, moderate, aggressive
RISK_LEVEL=aggressive
