# Polymarket API credentials
# API creds will be auto-derived from PRIVATE_KEY mnemonic
POLY_API_KEY=
POLY_API_SECRET=
POLY_PASSPHRASE=

# Wallet (mnemonic phrase — will be converted to hex key automatically)
PRIVATE_KEY=silent sport involve brisk evil yellow cable enemy gown tongue emerge crane

# Proxy disabled — VPS IP is already US-based
# PROXY_HOST=188.126.25.199
# PROXY_PORT=12323
# PROXY_USER=14a6a60c248d0
# PROXY_PASS=db3523dc6f

# Trading config
INITIAL_BALANCE=53
MAX_POSITION_SIZE=10
STOP_LOSS_PCT=0.10
TAKE_PROFIT_PCT=0.30
MAX_DAILY_LOSS=15

# Strategy
STRATEGY=combined
# Options: arbitrage, momentum, market_making, combined

# Risk level: conservative, moderate, aggressive
RISK_LEVEL=aggressive
